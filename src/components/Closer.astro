---
import { site } from '../data/site';
---

<section class="closer" aria-labelledby="closer-title">
  <div class="wrap closer__grid">
    <div class="closer__lead" data-reveal="1">
      <p class="closer__kicker"><span class="closer__chip" aria-hidden="true"></span>开始使用</p>
      <h2 id="closer-title">九个入口，<br />一块画布。</h2>
    </div>
    <div class="closer__action" data-reveal="2">
      <p class="closer__lede">免费、开源、离线可用。你的文件留在你自己的机器上。</p>
      <a class="button" href={site.download}>下载 PhotoCraft</a>
      <p class="closer__platforms">macOS / Windows / Linux / FreeBSD / Web</p>
    </div>
  </div>
</section>
