---
import '../styles/global.css';
import { site } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  canonicalUrl?: string;
  image?: string;
}

const {
  title = 'PhotoCraft：用纯 Rust 从零重写的开源图像编辑器',
  description = 'PhotoCraft 是净室逆向实现 Adobe Photoshop 的开源图像编辑器：图层、蒙版、调整图层、图层样式、文字、矢量、画笔与真正的 PSD 文件，全部运行在一个纯 Rust 编写的原生应用里。',
  canonicalUrl = 'https://getartcraft.com/apps/photocraft',
  image = '/og-image.jpg',
} = Astro.props;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#133621" />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph / WeChat / Telegram / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    <meta property="og:locale" content="zh_CN" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />

    <link
      rel="preload"
      href="/fonts/eb-garamond-roman.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="icon"
      href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' fill='%23133621'/%3E%3Crect x='8' y='8' width='16' height='16' fill='%23f4d96c'/%3E%3C/svg%3E"
    />
  </head>
  <body>
    <a class="skip" href="#index">跳到索引</a>

    <nav class="rail" aria-label="快捷导航">
      <div class="wrap rail__in">
        <a class="rail__mark" href="#top">
          <span class="rail__chip" aria-hidden="true"></span>
          PhotoCraft
        </a>
        <div class="rail__links">
          <a class="rail__index" href="#index">索引</a>
          <a href={site.github} rel="noopener">GitHub</a>
          <a class="rail__cta" href={site.download}>下载</a>
        </div>
      </div>
    </nav>

    <slot />

    <script>
      document.documentElement.classList.add('js');

      const rail = document.querySelector<HTMLElement>('.rail');
      const topline = document.querySelector<HTMLElement>('.topline');
      if (rail && topline && 'IntersectionObserver' in window) {
        new IntersectionObserver(
          ([entry]) => {
            rail.classList.toggle('is-on', !entry.isIntersecting);
          },
          { rootMargin: '-8px 0px 0px 0px' },
        ).observe(topline);
      } else {
        rail?.classList.add('is-on');
      }

      const reveals = document.querySelectorAll('[data-reveal]');
      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (e.isIntersecting) {
                e.target.classList.add('is-in');
                io.unobserve(e.target);
              }
            }
          },
          { rootMargin: '120px 0px 50px 0px', threshold: 0.02 },
        );
        reveals.forEach((el) => io.observe(el));
      } else {
        reveals.forEach((el) => el.classList.add('is-in'));
      }

      window.addEventListener('beforeprint', () => {
        reveals.forEach((el) => el.classList.add('is-in'));
      });
    </script>
  </body>
</html>
